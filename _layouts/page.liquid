---
layout: default
---
<div class="post">
  {% if page.tagline or page.subtext or page.hero_buttons or page.tags %}
    {% include hero.html %}
  {% else %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>
  {% endif %}

  <article>
    {{ content }}
  </article>
</div>
